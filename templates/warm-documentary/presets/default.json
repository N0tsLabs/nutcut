{
  "brand": "NUTCUT / FILM",
  "title": "把日子，过成故事",
  "subtitle": "A QUIET DOCUMENTARY",
  "accent": "#c07a4a",
  "lines": [
    {
      "id": "01",
      "text": "有些故事，不需要说得太快。",
      "start": 0,
      "end": 4.7
    },
    {
      "id": "02",
      "text": "清晨六点，水壶先醒了。",
      "start": 5,
      "end": 9.7
    },
    {
      "id": "03",
      "text": "一双旧鞋，走过三条街。",
      "start": 10,
      "end": 14.7
    },
    {
      "id": "04",
      "text": "沉默的地方，也藏着回答。",
      "start": 15,
      "end": 19.7
    },
    {
      "id": "05",
      "text": "慢下来，才听得见生活。",
      "start": 20,
      "end": 24.7
    },
    {
      "id": "06",
      "text": "把日子，过成值得记住的样子。",
      "start": 25,
      "end": 29.7
    }
  ]
}
