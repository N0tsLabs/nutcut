{
  "brand": "NUTCUT / KIDS",
  "title": "我们一起画个世界",
  "subtitle": "A CRAYON STORY",
  "accent": "#ff7eb6",
  "lines": [
    {
      "id": "01",
      "text": "今天，我们来画一个特别的世界。",
      "start": 0,
      "end": 4.7
    },
    {
      "id": "02",
      "text": "先画一个会笑的太阳。",
      "start": 5,
      "end": 9.7
    },
    {
      "id": "03",
      "text": "再画三朵不一样的花。",
      "start": 10,
      "end": 14.7
    },
    {
      "id": "04",
      "text": "画错了也没关系，可以变成云。",
      "start": 15,
      "end": 19.7
    },
    {
      "id": "05",
      "text": "数一数，一共几颗星星？",
      "start": 20,
      "end": 24.7
    },
    {
      "id": "06",
      "text": "画完啦，把它送给喜欢的人。",
      "start": 25,
      "end": 29.7
    }
  ]
}
