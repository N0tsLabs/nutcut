  "lines": [
    {
      "id": "01",
      "text": "信息越多，越需要秩序。",
      "start": 0,
      "end": 4.7
    },
    {
      "id": "02",
      "text": "先删掉不必要的装饰。",
      "start": 5,
      "end": 9.7
    },
    {
      "id": "03",
      "text": "再用网格，把关系摆清楚。",
      "start": 10,
      "end": 14.7
    },
    {
      "id": "04",
      "text": "红色只出现一次，所以它重要。",
      "start": 15,
      "end": 19.7
    },
    {
      "id": "05",
      "text": "留白不是空，是呼吸。",
      "start": 20,
      "end": 24.7
    },
    {
      "id": "06",
      "text": "少一点，反而说清楚。",
      "start": 25,
      "end": 29.7
    }
  ]
