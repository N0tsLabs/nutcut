{
  "brand": "NUTCUT / EARTH",
  "title": "慢一点，长出来",
  "subtitle": "GROW WITH THE SEASON",
  "accent": "#c98a5e",
  "lines": [
    {
      "id": "01",
      "text": "所有生长，都有自己的速度。",
      "start": 0,
      "end": 4.7
    },
    {
      "id": "02",
      "text": "一颗种子，先学会向下。",
      "start": 5,
      "end": 9.7
    },
    {
      "id": "03",
      "text": "然后向光，慢慢展开。",
      "start": 10,
      "end": 14.7
    },
    {
      "id": "04",
      "text": "风雨不是敌人，是年轮。",
      "start": 15,
      "end": 19.7
    },
    {
      "id": "05",
      "text": "根扎得越深，枝叶越远。",
      "start": 20,
      "end": 24.7
    },
    {
      "id": "06",
      "text": "慢一点，也会抵达春天。",
      "start": 25,
      "end": 29.7
    }
  ]
}
