{
  "title": "字，落成一场雨",
  "subtitle": "TYPE RAIN · 让文字自己走完这段路",
  "lines": [
    {
      "id": "01",
      "text": "每一个字，都是一滴下落的雨。",
      "start": 0,
      "end": 5
    },
    {
      "id": "02",
      "text": "先落下，再堆叠，最后冲刷成一句话。",
      "start": 5,
      "end": 10
    },
    {
      "id": "03",
      "text": "密度决定节奏，留白决定呼吸。",
      "start": 10,
      "end": 15
    },
    {
      "id": "04",
      "text": "被看见的词，才有重量。",
      "start": 15,
      "end": 20
    },
    {
      "id": "05",
      "text": "让文字自己走完这段路。",
      "start": 20,
      "end": 25
    },
    {
      "id": "06",
      "text": "雨停了，句子还亮着。",
      "start": 25,
      "end": 30
    }
  ]
}
